<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SLA_Met__c</fullName>
    <description>첫 응답이 응답 기한 이내면 true</description>
    <formula>AND(
    NOT(ISBLANK(First_Response_At__c)),
    NOT(ISBLANK(Response_Due_At__c)),
    First_Response_At__c &lt;= Response_Due_At__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>기한 준수</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
