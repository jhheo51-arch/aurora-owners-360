<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Risk_Level__c</fullName>
    <description>낮음 &lt;30 / 주의 &lt;60 / 높음</description>
    <formula>IF(ISBLANK(Risk_Score__c), &quot;&quot;, IF(Risk_Score__c &lt; 30, &quot;낮음&quot;, IF(Risk_Score__c &lt; 60, &quot;주의&quot;, &quot;높음&quot;)))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>위험 등급</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
