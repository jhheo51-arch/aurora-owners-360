<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approver_Required</fullName>
    <active>true</active>
    <description>승인·반려 상태에는 승인자(상담 직원)가 있어야 한다.</description>
    <errorConditionFormula>AND(
    OR(ISPICKVAL(Approval_Status__c, &quot;승인&quot;), ISPICKVAL(Approval_Status__c, &quot;반려&quot;)),
    ISBLANK(Approver__c)
)</errorConditionFormula>
    <errorDisplayField>Approver__c</errorDisplayField>
    <errorMessage>승인 또는 반려하려면 승인자를 지정하세요.</errorMessage>
</ValidationRule>
