<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reject_Note_Required</fullName>
    <active>true</active>
    <description>반려할 때는 차주에게 안내할 근거가 필요하므로 승인 의견 필수.</description>
    <errorConditionFormula>AND(ISPICKVAL(Approval_Status__c, &quot;반려&quot;), ISBLANK(Decision_Note__c))</errorConditionFormula>
    <errorDisplayField>Decision_Note__c</errorDisplayField>
    <errorMessage>반려할 때는 승인 의견(반려 사유)을 입력하세요.</errorMessage>
</ValidationRule>
